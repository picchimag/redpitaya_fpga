# Vivado projects: track only the per-project recipe (projects/<name>/bd.tcl)
# and any per-project constraints. Everything else under projects/ is generated
# by Vivado and rebuilt from the recipe via scripts/make_project.tcl.
/projects/*/build/
/projects/*/*.cache/
/projects/*/*.gen/
/projects/*/*.hw/
/projects/*/*.ip_user_files/
/projects/*/*.sim/
/projects/*/*.srcs/
/projects/*/*.runs/
/projects/*/*.xpr
/projects/*/*.jou
/projects/*/*.log
/projects/*/*.str
/projects/*/.Xil/
*.bit

/verilog_untested
/temp_python
/.obsidian
/.vscode
*.pyc
__pycache__/
*.egg-info
/dist

# xsim artefacts (see sim/README.md)
sim/xsim.dir/
sim/*.jou
sim/*.log
sim/*.pb
sim/*.wdb
sim/records.hex
# xsim run from the repo root rather than sim/
/xsim.dir/
/xvlog.*
/xelab.*
/xsim.*

# Vivado batch-run noise at the repo root
/vivado*.log
/vivado*.jou
/.Xil/
